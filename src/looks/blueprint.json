    "text": "#FFFFFF",
    "textMuted": "rgba(255,255,255,.70)",
    "accent": "#FFFFFF",
    "accent2": "#9FC5FF"
  },
  "fonts": {
    "display": "grotesk",
    "body": "jetbrains",
    "mono": "jetbrains"
  },
