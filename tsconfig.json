{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],

    // Phase 0: legacy JS is allowed but not type-checked. Spec §13 Phase 0 step 2:
    // "TypeScript (allowJs first, strict by Phase 2)". Flip checkJs on as src/ is
    // re-authored in TypeScript during Phases 1-2, then delete allowJs.
    "allowJs": true,
    "checkJs": false,

    "strict": true,

    // `strict: true` implies `alwaysStrict: true`, and esbuild honours that when it bundles
    // src/ — which prepends "use strict" to dist/index.html and silently flips the shipped
    // app from sloppy to strict mode. That changes real semantics (`this` binding in plain
    // functions, implicit globals becoming throws) on paths the suite does not cover yet,
    // such as video export and the Strava flow.
    //
    // Phase 0's job is to build the fence without touching the app: with this off, the
    // production bundle is byte-identical to dbbce71. Turn it on in Phase 1 as a deliberate,
    // separately verified change — by then the goldens exist to catch the fallout.
    "alwaysStrict": false,

    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "api/**/*", "*.mjs", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
