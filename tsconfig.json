{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],

    // Phase 0: legacy JS is allowed but not type-checked. Spec §13 Phase 0 step 2:
    // "TypeScript (allowJs first, strict by Phase 2)". Flip checkJs on as src/ is
    // re-authored in TypeScript during Phases 1-2, then delete allowJs.
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "*.mjs", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
